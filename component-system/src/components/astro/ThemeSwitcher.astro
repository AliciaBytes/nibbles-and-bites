---
// Based on https://fossheim.io/writing/posts/accessible-theme-picker-html-css-js/
---

<div id="theme-switcher" data-visible="false">
  <button class="tap-target" aria-pressed="false" data-theme="light"
    >Latte</button
  >
  <button class="tap-target" aria-pressed="false" data-theme="dark"
    >Mocha</button
  >
</div>

<script>
  const screenMediaQuery = window.matchMedia("screen");
  const themes = ["light", "dark"];

  const applyTheme = (theme: string) => {
    if (!screenMediaQuery.matches) {
      theme = "light";
    }

    const target = document.querySelector(
      `#theme-switcher button[data-theme="${theme}"]`
    );
    document.documentElement.setAttribute("data-theme", theme);

    document
      .querySelector('#theme-switcher [data-theme][aria-pressed="true"]')
      ?.setAttribute("aria-pressed", "false");

    target?.setAttribute("aria-pressed", "true");
  };

  const handleThemeSelection = (event: Event) => {
    const target = event.currentTarget as HTMLButtonElement;
    if (target.getAttribute("aria-pressed") !== "true") {
      const theme = target.getAttribute("data-theme");
      if (theme && themes.includes(theme)) {
        applyTheme(theme);
        localStorage.setItem("selected-theme", theme);
      }
    }
  };

  const applySavedTheme = () => {
    const savedTheme = localStorage.getItem("selected-theme");
    const theme =
      savedTheme === "light" || savedTheme === "catppuccin-latte"
        ? "light"
        : "dark";
    applyTheme(theme);
  };

  applySavedTheme();

  const themeSwitcher = document.querySelector("#theme-switcher");
  themeSwitcher?.querySelectorAll("button").forEach((button) => {
    button.addEventListener("click", handleThemeSelection);
  });

  screenMediaQuery.addEventListener("change", applySavedTheme, {
    passive: true,
  });
</script>

<style>
  @layer nb.component {
    :global(.no-js) #theme-switcher,
    #theme-switcher[data-visible="false"] {
      display: none;
    }

    #theme-switcher {
      display: grid;
      margin: 9px 0 0 0;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(min(10ch, 100%), 1fr));
    }

    button {
      border-color: var(--sl-color-gray-4);
    }

    button[aria-pressed="true"] {
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
    }
  }
</style>
