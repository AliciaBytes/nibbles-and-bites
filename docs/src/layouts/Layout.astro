---
export interface Props {
  title: string;
  description: string;
  metaTitle?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Head from "@src/components/astro/Head.astro";
import Header from "@src/components/astro/Header.astro";
import Footer from "@src/components/astro/Footer.astro";

import "virtual:starlight/user-css";

const { title, description, metaTitle, headings } = Astro.props;
console.log(JSON.stringify(headings));
const url = Astro.url;
---


<!doctype html>
<StarlightPage frontmatter={{title: title}} hasSidebar={false} headings={headings as any} >
  <Head title={title} description={description} metaTitle={metaTitle} />
  <body>
    <main class="grid-center-wrapper" data-pagefind-body>
      <div class="sl-markdown-content">
        <slot />
      </div>
    </main>
    <Footer class="grid-center-wrapper such-a-bottom" {title} {url} />
  </body>
</StarlightPage>

<style>
  :where(body) {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .such-a-bottom {
    margin-top: auto;
  }
</style>
